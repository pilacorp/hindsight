# Self-hosted Supabase (local dev). Copy to .env (Git-ignored).
#
# The keys below are Supabase's published DEMO values: the anon/service keys are
# JWTs signed by JWT_SECRET (HS256). They work out of the box for LOCAL DEV ONLY.
# Regenerate JWT_SECRET + anon/service keys for anything real.

POSTGRES_DB=postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_PUBLISH_PORT=54322

# HS256 signing secret. anon/service keys below MUST be signed with this.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
JWT_EXPIRY=3600

# Demo keys (role=anon / role=service_role), valid until 2033. Local dev only.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q

# Public gateway base URL (/auth/v1/* -> GoTrue).
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SUPABASE_PUBLISH_PORT=8000

# Public Hindsight URL used in invitation/recovery emails. No trailing slash.
# Include NEXT_PUBLIC_BASE_PATH here if deploying Hindsight under a subpath.
SITE_URL=http://localhost:9991
DISABLE_SIGNUP=false

# SMTP relay. Fill these on the server to enable delivery; do not commit credentials.
# For a relay running on the macOS host, use SMTP_HOST=host.docker.internal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Hindsight
# Keep true for offline local development; false requires signup email confirmation.
MAILER_AUTOCONFIRM=true

# Optional Studio override. Generate with: openssl rand -hex 32
# Leave unset when running only the minimal stack.
PG_META_CRYPTO_KEY=
STUDIO_PUBLISH_PORT=8001
SUPABASE_PUBLIC_URL=http://localhost:8000
