# Local Hindsight deployment (issue #10): Supabase tenant extension.
# Copy to .env (ignored by Git), fill in, keep readable by the owner only.
# Identity + Postgres come from a self-hosted open-source Supabase stack you run
# separately. Supabase Cloud is not a target.
#
# Images: build from this repo first.
#   # API with the upstream Supabase tenant extension:
#   docker build -f hindsight-extensions/supabase-tenant/Dockerfile \
#     --build-arg HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight-api:1.0.0-slim \
#     -t hindsight-api-supabase:dev .
#   # Control Plane (Supabase sign-in). NEXT_PUBLIC_* are inlined by next build,
#   # so pass them here (not only at runtime); the anon key is public by design:
#   docker build -f docker/standalone/Dockerfile --target cp-only \
#     --build-arg NEXT_PUBLIC_SUPABASE_URL="$NEXT_PUBLIC_SUPABASE_URL" \
#     --build-arg NEXT_PUBLIC_SUPABASE_ANON_KEY="$NEXT_PUBLIC_SUPABASE_ANON_KEY" \
#     -t hindsight-cp-nda:dev .
HINDSIGHT_API_IMAGE=hindsight-api-supabase:dev
HINDSIGHT_CP_IMAGE=hindsight-cp-nda:dev

# --- Credentials (required) ---------------------------------------------------
# The self-hosted Supabase stack's Postgres (it provides `vector`). Hindsight
# runs no database of its own. Inside a container the host is host.docker.internal.
HINDSIGHT_API_DATABASE_URL=

# Internal Supabase API base URL (NOT a *.supabase.co project). The tenant
# extension verifies JWTs against this project's JWKS and maps `sub` to a schema.
HINDSIGHT_API_TENANT_SUPABASE_URL=

# service_role key — ONLY for legacy HS256 projects or the startup health check.
# Prefer JWKS verification: leave this empty. Stays server-side; never committed.
HINDSIGHT_API_TENANT_SUPABASE_SERVICE_KEY=

# Browser-side Supabase client for the dashboard sign-in (safe to expose).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter key (LLM + embeddings + reranking). Server-side only.
HINDSIGHT_API_LLM_API_KEY=

# --- Models -------------------------------------------------------------------
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
HINDSIGHT_EMBEDDINGS_MODEL=perplexity/pplx-embed-v1-0.6b
HINDSIGHT_RERANKER_MODEL=voyageai/rerank-3-lite

# --- Optional (defaults shown) ------------------------------------------------
# Schema name prefix; user id -> <prefix>_<uuid> (hyphens become underscores).
#HINDSIGHT_API_TENANT_SCHEMA_PREFIX=user
#HINDSIGHT_BIND_ADDRESS=127.0.0.1
#HINDSIGHT_API_PUBLISH_PORT=8891
#HINDSIGHT_CP_PUBLISH_PORT=9991
#HINDSIGHT_API_LOG_LEVEL=warning
# Force every extracted fact and answer into one language, e.g. Vietnamese.
#HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=
