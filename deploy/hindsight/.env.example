# NDA multi-user Hindsight deployment - all configuration, credentials included.
# Copy to .env (ignored by Git), fill in, keep readable by the owner only.
#
# Images: build the two custom images from this repo first (or pull the pinned
# ones once CI publishes them), then set the tags/digests here.
#   docker build -f hindsight-extensions/nda-multiuser/Dockerfile \
#     --build-arg HINDSIGHT_IMAGE=ghcr.io/vectorize-io/hindsight-api:1.0.0-slim \
#     -t hindsight-api-nda:dev .
#   docker build -f docker/standalone/Dockerfile --target cp-only -t hindsight-cp-nda:dev .
HINDSIGHT_API_IMAGE=hindsight-api-nda:dev
HINDSIGHT_CP_IMAGE=hindsight-cp-nda:dev

# --- Credentials (required) ---------------------------------------------------
# External PostgreSQL 14+ with pgvector. Not localhost inside a container;
# Docker Desktop host is host.docker.internal.
HINDSIGHT_API_DATABASE_URL=

# Server-side secret that peppers the stored API-key hashes. openssl rand -hex 32
HINDSIGHT_API_TENANT_KEY_PEPPER=

# Encrypts the Control Plane per-user session cookie. openssl rand -hex 32
HINDSIGHT_CP_SESSION_SECRET=

# OpenRouter key (LLM + embeddings + reranking). Server-side only.
HINDSIGHT_API_LLM_API_KEY=

# --- Models -------------------------------------------------------------------
HINDSIGHT_API_LLM_MODEL=openai/gpt-oss-20b
HINDSIGHT_EMBEDDINGS_MODEL=perplexity/pplx-embed-v1-0.6b
HINDSIGHT_RERANKER_MODEL=voyageai/rerank-3-lite

# --- Optional (defaults shown) ------------------------------------------------
#HINDSIGHT_BIND_ADDRESS=127.0.0.1
#HINDSIGHT_API_PUBLISH_PORT=8891
#HINDSIGHT_CP_PUBLISH_PORT=9991
#HINDSIGHT_API_LOG_LEVEL=warning
# Force every extracted fact and answer into one language, e.g. Vietnamese.
#HINDSIGHT_API_LLM_OUTPUT_LANGUAGE=
